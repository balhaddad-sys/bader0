# Required: a Venice API key from https://venice.ai/settings/api
VENICE_API_KEY=

# Optional model overrides. When unset, models are picked from the live catalog by Venice trait:
#   agent -> "function_calling_default", chat -> "default", image -> "default"
# VENICE_AGENT_MODEL=
# VENICE_CHAT_MODEL=
# VENICE_IMAGE_MODEL=
# VENICE_TTS_MODEL=tts-kokoro
# VENICE_TTS_VOICE=af_sky
# VENICE_EMBEDDING_MODEL=text-embedding-bge-m3

# Optional: upstream timeout per request in milliseconds (default 120000)
# VENICE_TIMEOUT_MS=120000

# Optional: Streamable HTTP instead of stdio
# TRANSPORT=http
# PORT=3000
# HOST=127.0.0.1
# MCP_AUTH_TOKEN=          # required when HOST is not localhost
# ALLOWED_HOSTS=mcp.example.com
