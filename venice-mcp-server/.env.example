# Required: a Venice API key from https://venice.ai/settings/api
VENICE_API_KEY=

# Optional model overrides. When unset, models are picked from the live catalog by Venice trait:
#   agent -> "function_calling_default", chat -> "default", image -> "default"
# VENICE_AGENT_MODEL=
# VENICE_CHAT_MODEL=
# VENICE_IMAGE_MODEL=
# VENICE_TTS_MODEL=tts-kokoro
# VENICE_TTS_VOICE=af_sky
# VENICE_EMBEDDING_MODEL=text-embedding-bge-m3

# Optional: upstream timeout per request in milliseconds (default 120000)
# VENICE_TIMEOUT_MS=120000

# Optional: Streamable HTTP instead of stdio
# TRANSPORT=http
# PORT=3000
# HOST=127.0.0.1
# MCP_AUTH_TOKEN=          # required when HOST is not localhost
# ALLOWED_HOSTS=mcp.example.com

# Local Wan video through ComfyUI (free; never sent to Venice)
# ComfyUI has no authentication: keep this on loopback unless it sits behind an authenticating proxy.
# WAN_BASE_URL=http://127.0.0.1:8188
# WAN_OUTPUT_DIR=/tmp/venice-mcp-wan
# WAN_MODEL=wan2.1_t2v_1.3B_fp16.safetensors   # default: chosen from the GPU's VRAM
# WAN_TIMEOUT=1800                             # seconds before a job is reported as timed out
# WAN_WORKFLOW_T2V=/path/to/wan_t2v_api.json   # API-format export; default: bundled Wan 2.1
# WAN_WORKFLOW_I2V=/path/to/wan_i2v_api.json
# WAN_POLL_INTERVAL_MS=2000
